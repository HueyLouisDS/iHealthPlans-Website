# Copy to .env.local and fill in. .env.local is gitignored, this file is not,
# so never put a real secret in here.

# ---------------------------------------------------------------------------
# Admin authentication
# ---------------------------------------------------------------------------

# Signing key for the session cookie. Generate with:
#   openssl rand -base64 32
# Changing it signs everyone out, which is also how you revoke every session
# at once if you ever need to.
AUTH_SECRET=

# Google OAuth client, created in Google Cloud Console under the same
# organisation as the Workspace account. Authorised redirect URI must be
# exactly, for local work:
#   http://localhost:3000/api/auth/callback/google
# and for each deployed environment, the same path on that origin.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The Workspace domain. Checked server side against the verified email address
# Google returns. Necessary but NOT sufficient on its own, since every licensed
# agent also has an address on this domain.
LH_ADMIN_ALLOWED_DOMAIN=ihealthplans.com

# Comma separated list of the management addresses allowed into the reporting
# area. This is the control that actually keeps agents out.
# If this is empty, nobody gets in. That is deliberate, it fails closed.
LH_ADMIN_ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Database, not wired up yet
# ---------------------------------------------------------------------------

DATABASE_URL=mysql://user:password@host:3306/ihealthplans

# Apply the schema with:  node scripts/migrate.mjs
# See what is pending with: node scripts/migrate.mjs --status
#
# The pool is deliberately 2 connections. On serverless that is 2 per warm
# instance, not 2 in total, so raising it is how you exhaust the server. See
# the banner in lib/db/client.js before changing it.

# ---------------------------------------------------------------------------
# Not yet identified, see the handoff brief
# ---------------------------------------------------------------------------

# TODO phone system credentials, once the vendor is known
# TODO crm credentials, once the vendor is known
# TODO careers application destination, /api/careers currently delivers nowhere

# Serves fabricated demo data in the admin area so the reporting interface can
# be built before tracking exists. Local only, NEVER set this in a deployed
# environment. Any page showing it displays a red banner saying so.
LH_ADMIN_USE_FIXTURES=false

# Development only auth bypass so the admin ui can be built before a Google
# OAuth client exists. Only works under `next dev`, since next build always
# sets NODE_ENV=production and the guard checks it. Delete once OAuth is set up.
LH_ADMIN_DEV_BYPASS_AUTH=false

# ---------------------------------------------------------------------------
# Lead ingestion from vendors, POST /api/leads/inbound
# ---------------------------------------------------------------------------

# One key per vendor, comma separated, as vendorId:key
#   LH_LEAD_VENDOR_KEYS=acme-leads:sk_live_xxxx,other-vendor:sk_live_yyyy
#
# The vendorId becomes the lead's source, so it is what shows up in
# /admin/attribution beside google / cpc. Keep it short and stable, renaming
# one splits its history into 2 rows.
#
# Generate a key with: openssl rand -hex 32
# Unset means the endpoint answers 503 rather than 401, so nobody wastes a day
# checking a key against an environment that was never configured.
LH_LEAD_VENDOR_KEYS=

# ---------------------------------------------------------------------------
# Outbound integrations, the dialer and the CRM
# ---------------------------------------------------------------------------

# NEVER prefix any of these with NEXT_PUBLIC_. That prefix compiles the value
# into the JavaScript sent to the browser, where anybody can read it. The app
# refuses to start if it finds a NEXT_PUBLIC_ variable whose name looks like a
# secret, see assertNoPublicSecrets in lib/integrations/config.js.
#
# Base urls must be https. These requests carry beneficiary names, phone
# numbers, and plan details, so plain http is rejected except on localhost for
# developing against a mock.
#
# All 3 of a set are required together. Two out of 3 counts as unconfigured,
# because a request to the right host with no key just becomes a 401 nobody
# reads.

LH_DIALER_BASE_URL=
LH_DIALER_API_ID=
LH_DIALER_API_KEY=

LH_CRM_BASE_URL=
LH_CRM_API_ID=
LH_CRM_API_KEY=

# The vendor post endpoint, which is how the site writes a lead into TLD.
#
# Authenticates differently from the 2 sets above. There are no headers, the
# vendor id and post key travel as url parameters on the POST itself. Treat the
# post key as a full credential despite where it sits, it is the only thing
# standing between anyone and writing leads into the account.
#
# The vendor id changes between the test vendor and the live one, which is why
# it is configuration and not a constant.
#
# Put the bare endpoint in the url. Do not paste the full url from the TLD
# posting instructions, it has the key in the query string and the query string
# is stripped on read.

LH_DIALER_POST_URL=https://ihp.tldcrm.com/post
LH_DIALER_POST_VENDOR_ID=
LH_DIALER_POST_KEY=
