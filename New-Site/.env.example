# Copy to .env.local and fill in. .env.local is gitignored, this file is not,
# so never put a real secret in here.

# ---------------------------------------------------------------------------
# Admin authentication
# ---------------------------------------------------------------------------

# Signing key for the session cookie. Generate with:
#   openssl rand -base64 32
# Changing it signs everyone out, which is also how you revoke every session
# at once if you ever need to.
AUTH_SECRET=

# Google OAuth client, created in Google Cloud Console under the same
# organisation as the Workspace account. Authorised redirect URI must be
# exactly, for local work:
#   http://localhost:3000/api/auth/callback/google
# and for each deployed environment, the same path on that origin.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The Workspace domain. Checked server side against the verified email address
# Google returns. Necessary but NOT sufficient on its own, since every licensed
# agent also has an address on this domain.
#
# Set here only. Not settable from /admin/integrations by design, since being
# able to change the domain and the allowlist in one request would let an
# administrator widen the domain and then add themselves to it.
LH_ADMIN_ALLOWED_DOMAIN=ihealthplans.com

# The management addresses allowed into the reporting area. This is the control
# that actually keeps agents out.
#
# Stored comma separated. Managed from /admin/integrations, where it is a chip
# per address rather than a string to hand edit, and where an address off the
# domain above is refused both in the form and on the server.
#
# If this is empty, nobody gets in. That is deliberate, it fails closed.
LH_ADMIN_ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Database, Postgres
# ---------------------------------------------------------------------------

# Quote it. A generated password containing a $ is otherwise read as a variable
# and the rest of the line is silently eaten.
#
# On a managed host use the POOLED connection string, the one with -pooler in
# the hostname. Serverless opens connections faster than Postgres closes them
# and the direct host runs out under any real traffic.
DATABASE_URL='postgresql://user:password@host:5432/dbname?sslmode=require'

# Or set these instead, which avoids url encoding the password entirely.
# LH_DB_HOST takes precedence over DATABASE_URL when both are present.
# LH_DB_HOST=
# LH_DB_PORT=5432
# LH_DB_USER=
# LH_DB_PASSWORD=
# LH_DB_NAME=

# TLS. Unset means encrypted and the certificate verified, which is what any
# managed host supports. no-verify is a downgrade for a self signed server,
# false is plaintext and local only.
# LH_DB_SSL=

# Apply the schema with:  node scripts/migrate.mjs
# See what is pending with: node scripts/migrate.mjs --status
# Check the resolved settings with: node scripts/migrate.mjs --check
#
# The pool is deliberately 2 connections. On serverless that is 2 per warm
# instance, not 2 in total, so raising it is how you exhaust the server. See
# the banner in lib/db/client.js before changing it.
#
# The session is pinned to America/New_York in lib/db/dsn.js. That does not
# change what is stored, it decides what a date means when one is derived from
# a timestamp, so a report grouped by day lands on the Eastern business day.

# ---------------------------------------------------------------------------
# Not yet identified, see the handoff brief
# ---------------------------------------------------------------------------

# TODO phone system credentials, once the vendor is known
# TODO crm credentials, once the vendor is known
# TODO careers application destination, /api/careers currently delivers nowhere

# Serves fabricated demo data in the admin area so the reporting interface can
# be built before tracking exists. Local only, NEVER set this in a deployed
# environment. Any page showing it displays a red banner saying so.
LH_ADMIN_USE_FIXTURES=false

# Development only auth bypass so the admin ui can be built before a Google
# OAuth client exists. Only works under `next dev`, since next build always
# sets NODE_ENV=production and the guard checks it. Delete once OAuth is set up.
LH_ADMIN_DEV_BYPASS_AUTH=false

# ---------------------------------------------------------------------------
# Lead ingestion from vendors, POST /api/leads/inbound
# ---------------------------------------------------------------------------

# One key per vendor, comma separated, as vendorId:key
#   LH_LEAD_VENDOR_KEYS=acme-leads:sk_live_xxxx,other-vendor:sk_live_yyyy
#
# The vendorId becomes the lead's source, so it is what shows up in
# /admin/attribution beside google / cpc. Keep it short and stable, renaming
# one splits its history into 2 rows.
#
# Generate a key with: openssl rand -hex 32
# Unset means the endpoint answers 503 rather than 401, so nobody wastes a day
# checking a key against an environment that was never configured.
LH_LEAD_VENDOR_KEYS=

# ---------------------------------------------------------------------------
# Outbound integrations, the dialer and the CRM
# ---------------------------------------------------------------------------

# NEVER prefix any of these with NEXT_PUBLIC_. That prefix compiles the value
# into the JavaScript sent to the browser, where anybody can read it. The app
# refuses to start if it finds a NEXT_PUBLIC_ variable whose name looks like a
# secret, see assertNoPublicSecrets in lib/integrations/config.js.
#
# Base urls must be https. These requests carry beneficiary names, phone
# numbers, and plan details, so plain http is rejected except on localhost for
# developing against a mock.
#
# All 3 of a set are required together. Two out of 3 counts as unconfigured,
# because a request to the right host with no key just becomes a 401 nobody
# reads.
LH_CRM_BASE_URL=

LH_CRM_API_ID=
LH_CRM_API_KEY=

# The vendor source, which is how the site posts a lead into TLD.
#
# Authenticates differently from the 2 sets above. There are no headers, the
# vendor id and post key travel as url parameters on the POST itself. Treat the
# post key as a full credential despite where it sits, it is the only thing
# standing between anyone and writing leads into the account.
#
# The vendor id changes between the test vendor and the live one, which is why
# it is configuration and not a constant.
#
# Put the bare endpoint in the url. Do not paste the full url from the TLD
# posting instructions, it has the key in the query string and the query string
# is stripped on read.

LH_VENDOR_POST_URL=https://ihp.tldcrm.com/post

# The debug view of the last 100 posts, showing how TLD read your field
# mapping. Optional, the post works without it. Same vendor id and post key,
# only the path differs.
LH_VENDOR_RESULTS_URL=https://ihp.tldcrm.com/public/vendors
LH_VENDOR_ID=
LH_VENDOR_POST_KEY=

# ---------------------------------------------------------------------------
# The TLD sync
# ---------------------------------------------------------------------------

# Where scripts/sync.mjs calls. The sync runs inside the app rather than in the
# script, because the alias, server-only, and cache invalidation all need the
# Next runtime.
LH_SITE_URL=http://localhost:3000

# Lets cron run the sync without a session. Generate with:
#   openssl rand -hex 32
# Unset closes the header route entirely rather than leaving it open with an
# empty secret, so an unconfigured cron fails loudly instead of quietly
# accepting anything that finds the endpoint.
LH_CRON_SECRET=

# ---------------------------------------------------------------------------
# Break glass access
# ---------------------------------------------------------------------------

# One address, outside the client's domain, that gets into /admin when nobody
# at the client can. Skips the domain check and the allowlist. Does not skip
# Google, so the holder still has to prove they control the account.
#
# Every use is logged as BREAK GLASS ACCESS with the address and timestamp.
#
# Remove this at handoff. It is a build and support tool, and unset is the
# correct state once the client owns the site. Not settable from the admin UI
# by design, it is absent from lib/integrations/fields.js.
LH_DEVELOPER_EMAIL=

# ---------------------------------------------------------------------------
# Outbound mail, for admin invites
# ---------------------------------------------------------------------------
#
# Google Workspace SMTP, so invitations leave from the client's own domain
# rather than from a third party sending on their behalf. No DNS records to
# add and deliverability is already established.
#
# LH_SMTP_PASSWORD is a Google app password, not the account password. Generate
# it at myaccount.google.com/apppasswords, which needs 2-Step Verification on
# that mailbox first. It arrives with spaces for readability and they are not
# part of the secret, the code strips them either way.
#
# Pick the mailbox deliberately. Whatever this is, recipients see it as the
# sender, and an invitation from a personal address reads oddly after handoff.
#
# All 4 unset is a supported state. Invites are still created and the link is
# shown in the admin page to be sent by hand.
LH_SMTP_HOST=smtp.gmail.com
LH_SMTP_PORT=465
LH_SMTP_USER=
LH_SMTP_PASSWORD=
LH_MAIL_FROM=iHealth Plans <noreply@ihealthplans.com>
